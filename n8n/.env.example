# This file documents the variables docker-compose.yml expects.
# In production, /opt/n8n/app/.env is generated automatically by the VM's
# startup-script (see terraform/main/templates/startup-script.sh.tftpl),
# which derives SUBDOMAIN/DOMAIN_NAME from the `domain` Terraform variable.
# This example is for local reference only - do not put real secrets here
# (n8n's docker-compose.yml doesn't currently take any secret-valued env
# vars; see terraform/main/secrets.tf for why).

SUBDOMAIN=n8n
DOMAIN_NAME=u-rei.com
SSL_EMAIL=byebyeearthjpn@gmail.com
GENERIC_TIMEZONE=Asia/Tokyo
